<?xml version="1.0"?>
<!-- Geometry generated from cad/config/parameters.py on 2026-08-20.
     Units: SI. Status: UNVERIFIED / PHYSICAL VALIDATION REQUIRED. -->
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="figbot_v0">
  <xacro:property name="upper" value="0.300"/>
  <xacro:property name="fore" value="0.220"/>
  <xacro:property name="tool" value="0.085"/>
  <xacro:property name="base_height" value="0.190"/>
  <xacro:property name="tube_y" value="0.040"/>
  <xacro:property name="tube_z" value="0.030"/>

  <material name="figbot_orange"><color rgba="0.94 0.38 0.08 1"/></material>
  <material name="aluminium"><color rgba="0.68 0.71 0.73 1"/></material>
  <material name="soft_gripper"><color rgba="0.18 0.42 0.27 1"/></material>

  <xacro:macro name="inertial_box" params="mass x y z">
    <inertial>
      <origin xyz="${x/2} 0 0"/>
      <mass value="${mass}"/>
      <inertia ixx="${mass*(y*y+z*z)/12}" ixy="0" ixz="0" iyy="${mass*(x*x+z*z)/12}" iyz="0" izz="${mass*(x*x+y*y)/12}"/>
    </inertial>
  </xacro:macro>

  <link name="base_link">
    <visual><origin xyz="0 0 ${base_height/2}"/><geometry><cylinder radius="0.10" length="${base_height}"/></geometry><material name="figbot_orange"/></visual>
    <collision><origin xyz="0 0 ${base_height/2}"/><geometry><cylinder radius="0.10" length="${base_height}"/></geometry></collision>
    <inertial><origin xyz="0 0 ${base_height/2}"/><mass value="2.4"/><inertia ixx="0.028" ixy="0" ixz="0" iyy="0.028" iyz="0" izz="0.012"/></inertial>
  </link>

  <link name="shoulder_yaw"><inertial><mass value="0.15"/><inertia ixx="0.0003" ixy="0" ixz="0" iyy="0.0003" iyz="0" izz="0.0003"/></inertial></link>
  <joint name="J1" type="revolute">
    <parent link="base_link"/><child link="shoulder_yaw"/><origin xyz="0 0 ${base_height}"/><axis xyz="0 0 1"/>
    <limit lower="-2.007129" upper="2.007129" velocity="3.141593" effort="20"/>
  </joint>

  <link name="upper_arm">
    <visual><origin xyz="${upper/2} 0 0"/><geometry><box size="${upper} ${tube_y} ${tube_z}"/></geometry><material name="aluminium"/></visual>
    <collision><origin xyz="${upper/2} 0 0"/><geometry><box size="${upper} ${tube_y} ${tube_z}"/></geometry></collision>
    <xacro:inertial_box mass="0.149" x="${upper}" y="${tube_y}" z="${tube_z}"/>
  </link>
  <joint name="J2" type="revolute">
    <parent link="shoulder_yaw"/><child link="upper_arm"/><axis xyz="0 -1 0"/>
    <limit lower="-1.396263" upper="1.745329" velocity="2.094395" effort="30"/>
  </joint>

  <link name="forearm">
    <visual><origin xyz="${fore/2} 0 0"/><geometry><box size="${fore} ${tube_y} ${tube_z}"/></geometry><material name="aluminium"/></visual>
    <collision><origin xyz="${fore/2} 0 0"/><geometry><box size="${fore} ${tube_y} ${tube_z}"/></geometry></collision>
    <xacro:inertial_box mass="0.109" x="${fore}" y="${tube_y}" z="${tube_z}"/>
  </link>
  <joint name="J3" type="revolute">
    <parent link="upper_arm"/><child link="forearm"/><origin xyz="${upper} 0 0"/><axis xyz="0 -1 0"/>
    <limit lower="-2.356194" upper="2.356194" velocity="3.141593" effort="20"/>
  </joint>

  <link name="wrist_tool">
    <visual><origin xyz="${tool/2} 0 0"/><geometry><box size="${tool} 0.045 0.035"/></geometry><material name="figbot_orange"/></visual>
    <collision><origin xyz="${tool/2} 0 0"/><geometry><box size="${tool} 0.045 0.035"/></geometry></collision>
    <xacro:inertial_box mass="0.12" x="${tool}" y="0.045" z="0.035"/>
  </link>
  <joint name="J4" type="revolute">
    <parent link="forearm"/><child link="wrist_tool"/><origin xyz="${fore} 0 0"/><axis xyz="0 -1 0"/>
    <limit lower="-1.745329" upper="1.745329" velocity="3.141593" effort="8"/>
  </joint>

  <link name="gripper_body">
    <visual><geometry><box size="0.035 0.072 0.040"/></geometry><material name="soft_gripper"/></visual>
    <collision><geometry><box size="0.035 0.072 0.040"/></geometry></collision>
    <inertial><mass value="0.20"/><inertia ixx="0.00012" ixy="0" ixz="0" iyy="0.00008" iyz="0" izz="0.00012"/></inertial>
  </link>
  <joint name="tool_mount" type="fixed"><parent link="wrist_tool"/><child link="gripper_body"/><origin xyz="${tool} 0 0"/></joint>

  <link name="gripper_finger">
    <visual><origin xyz="0 0.035 -0.025"/><geometry><box size="0.018 0.012 0.070"/></geometry><material name="soft_gripper"/></visual>
    <collision><origin xyz="0 0.035 -0.025"/><geometry><box size="0.018 0.012 0.070"/></geometry></collision>
    <inertial><mass value="0.02"/><inertia ixx="0.00001" ixy="0" ixz="0" iyy="0.00001" iyz="0" izz="0.000003"/></inertial>
  </link>
  <joint name="G1" type="prismatic">
    <parent link="gripper_body"/><child link="gripper_finger"/><axis xyz="0 1 0"/>
    <limit lower="0" upper="0.045" velocity="0.12" effort="8"/>
  </joint>

  <ros2_control name="FigbotV0System" type="system">
    <!-- Mock hardware supports controller bring-up without claiming a real driver. -->
    <hardware><plugin>mock_components/GenericSystem</plugin></hardware>
    <xacro:macro name="controlled_joint" params="name initial">
      <joint name="${name}">
        <command_interface name="position"/>
        <state_interface name="position"><param name="initial_value">${initial}</param></state_interface>
        <state_interface name="velocity"/>
      </joint>
    </xacro:macro>
    <xacro:controlled_joint name="J1" initial="0"/>
    <xacro:controlled_joint name="J2" initial="0"/>
    <xacro:controlled_joint name="J3" initial="0"/>
    <xacro:controlled_joint name="J4" initial="0"/>
    <xacro:controlled_joint name="G1" initial="0"/>
  </ros2_control>
</robot>
