<?xml version="1.0" ?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/kolRoot" android:layout_width="match_parent" android:layout_height="match_parent" android:background="#0B100E">
    
 
    <android.opengl.GLSurfaceView android:id="@+id/surfaceView" android:layout_width="match_parent" android:layout_height="match_parent"/>
    
 
    <com.figbot.scanner.TargetOverlayView android:id="@+id/overlay" android:layout_width="match_parent" android:layout_height="match_parent"/>
    
 
    <LinearLayout android:layout_width="match_parent" android:layout_height="48dp" android:layout_gravity="top" android:layout_marginStart="8dp" android:layout_marginTop="8dp" android:layout_marginBottom="8dp" android:layout_marginEnd="104dp" android:gravity="center_vertical" android:background="@drawable/bg_card" android:padding="8dp" android:orientation="horizontal">
        
  
        <TextView android:id="@+id/chip" android:layout_width="wrap_content" android:layout_height="wrap_content" android:padding="6dp" android:background="@drawable/bg_chip_moving" android:text="HAREKETLİ" android:textColor="#FFFFFF" android:textSize="12sp" android:textStyle="bold"/>
        
  
        <TextView android:id="@+id/statusLine" android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent" android:layout_marginStart="8dp" android:gravity="center_vertical" android:text="Menü → Bağlan" android:textColor="#FFFFFF" android:textSize="13sp" android:maxLines="2" android:ellipsize="end"/>
        
 
    </LinearLayout>
    
 
    <ScrollView android:id="@+id/controlsPanel" android:layout_width="320dp" android:layout_height="match_parent" android:layout_gravity="end" android:layout_marginTop="64dp" android:layout_marginBottom="80dp" android:layout_marginEnd="8dp" android:background="@drawable/bg_card" android:visibility="gone" android:fillViewport="false" android:elevation="6dp">
        
  
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="8dp">
            

            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
                <Button android:id="@+id/connectButton" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:minHeight="48dp" android:layout_margin="4dp" android:background="@drawable/bg_btn_neutral" android:text="Bağlan" android:textAllCaps="false" android:textColor="#FFFFFF" android:textSize="14sp" android:padding="8dp"/>
                <Button android:id="@+id/holdButton" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:minHeight="48dp" android:layout_margin="4dp" android:background="@drawable/bg_btn_neutral" android:text="Kolu tut" android:textAllCaps="false" android:textColor="#FFFFFF" android:textSize="14sp" android:padding="8dp"/>
            </LinearLayout>
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
                <Button android:id="@+id/calibButton" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:minHeight="48dp" android:layout_margin="4dp" android:background="@drawable/bg_btn_neutral" android:text="Kalibre" android:textAllCaps="false" android:textColor="#FFFFFF" android:textSize="14sp" android:padding="8dp"/>
                <Button android:id="@+id/homeButton" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:minHeight="48dp" android:layout_margin="4dp" android:background="@drawable/bg_btn_neutral" android:text="Başlangıca dön" android:textAllCaps="false" android:textColor="#FFFFFF" android:textSize="14sp" android:padding="8dp"/>
            </LinearLayout>
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
                <Button android:id="@+id/followButton" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:minHeight="48dp" android:layout_margin="4dp" android:background="@drawable/bg_btn_go" android:text="Hedefe Git" android:textAllCaps="false" android:textColor="#FFFFFF" android:textSize="14sp" android:padding="8dp"/>
            </LinearLayout>
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
                <Button android:id="@+id/speedSlow" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:minHeight="48dp" android:layout_margin="4dp" android:background="@drawable/bg_btn_neutral" android:text="Yavaş" android:textAllCaps="false" android:textColor="#FFFFFF" android:textSize="14sp" android:padding="8dp"/>
                <Button android:id="@+id/speedMedium" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:minHeight="48dp" android:layout_margin="4dp" android:background="@drawable/bg_btn_neutral" android:text="Orta" android:textAllCaps="false" android:textColor="#FFFFFF" android:textSize="14sp" android:padding="8dp"/>
                <Button android:id="@+id/speedFast" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:minHeight="48dp" android:layout_margin="4dp" android:background="@drawable/bg_btn_neutral" android:text="Hızlı" android:textAllCaps="false" android:textColor="#FFFFFF" android:textSize="14sp" android:padding="8dp"/>
            </LinearLayout>
            <TextView android:id="@+id/errorLine" android:layout_width="match_parent" android:layout_height="wrap_content" android:padding="8dp" android:text="" android:textColor="#FFB5AB" android:textSize="13sp" android:maxLines="3" android:ellipsize="end" android:visibility="gone"/>
            

            <TextView android:id="@+id/markerLine" android:layout_width="match_parent" android:layout_height="wrap_content" android:padding="8dp" android:text="Etiket bekleniyor" android:textColor="#65E7FF" android:textSize="13sp" android:maxLines="3" android:ellipsize="end"/>
            

            <TextView android:id="@+id/targetLine" android:layout_width="match_parent" android:layout_height="wrap_content" android:padding="8dp" android:text="Kol bağlı değil" android:textColor="#D9FFE9" android:textSize="13sp" android:maxLines="3" android:ellipsize="end"/>
            
 
        </LinearLayout>
        
 
    </ScrollView>
    
 
    <Button android:id="@+id/menuButton" android:layout_width="88dp" android:layout_height="48dp" android:layout_gravity="top|end" android:layout_margin="8dp" android:background="@drawable/bg_btn_neutral" android:text="MENÜ" android:textColor="#FFFFFF" android:textSize="14sp" android:contentDescription="Kontrol menüsünü aç"/>
    
 
    <Button android:id="@+id/stopButton" android:layout_width="88dp" android:layout_height="56dp" android:layout_gravity="bottom|end" android:layout_margin="12dp" android:background="@drawable/bg_btn_stop" android:text="DUR" android:textColor="#FFFFFF" android:textSize="18sp" android:textStyle="bold" android:contentDescription="Kol hareketini durdur"/>
    

</FrameLayout>
